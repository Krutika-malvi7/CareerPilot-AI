# Copy this file to .env and add your own values.
# Get a key from the official Groq Console. Never commit your real .env file.
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# Use a long random secret in production.
FLASK_SECRET_KEY=replace-this-with-a-long-random-secret
FLASK_DEBUG=false
